// The hosted cohort board. Nothing here is tied to one Cloudflare account: `wrangler` uses whoever is logged in.
// Secrets (set by setup.sh, never in git): BOARD_PASSWORD, CONTACT_KEY, STATE_TOKEN, PUBLIC_URL, COHORT_API_URL,
// COHORT_API_TOKEN, optional ANTHROPIC_API_KEY.
{
  "name": "cohort-board",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Board",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "standard-2"         // 6 GB: the daily refresh loads a ~370 MB job download
    }
  ],
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "cohort-board-state" }],
  // every 15 minutes: merge Muse's findings if any are waiting; daily 09:00 UTC: the job refresh (src/index.js DAILY)
  "triggers": { "crons": ["*/15 * * * *", "0 9 * * *"] }
}
